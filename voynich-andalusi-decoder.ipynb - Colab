><span class="mtk1">,&nbsp;</span><span class="mtk12">0.095</span><span class="mtk1">,&nbsp;</span><span class="mtk12">0.091</span><span class="mtk1">,&nbsp;</span><span class="mtk12">0.090</span><span class="mtk1">,&nbsp;</span><span class="mtk12">0.084</span><span class="mtk1">,&nbsp;</span><span class="mtk12">0.082</span><span class="mtk1">,&nbsp;</span><span class="mtk12">0.080</span><span class="mtk1">,&nbsp;</span><span class="mtk12">0.065</span><span class="mtk1">])</span></span><br><span><span></span></span><br><span><span class="mtk8">#&nbsp;Cálculo&nbsp;de&nbsp;correlación&nbsp;lineal&nbsp;de&nbsp;Pearson&nbsp;y&nbsp;</span><span class="mtk8">distancia&nbsp;euclidiana</span></span><br><span><span class="mtk1">corr&nbsp;=&nbsp;np.corrcoef(freq_voynich,&nbsp;freq_andalusi)[</span><span class="mtk12">0</span><span class="mtk1">,&nbsp;</span><span class="mtk12">1</span><span class="mtk1">]</span></span><br><span><span class="mtk1">dist_l2&nbsp;=&nbsp;np.linalg.norm(freq_voynich&nbsp;-&nbsp;freq_andal</span><span class="mtk1">usi)</span></span><br><span><span></span></span><br><span><span class="mtk8">#&nbsp;Divergencia&nbsp;de&nbsp;Kullback-Leibler</span></span><br><span><span class="mtk1">d_kl&nbsp;=&nbsp;np.</span><span class="mtk15">sum</span><span class="mtk1">(freq_voynich&nbsp;*&nbsp;np.log(freq_voynich&nbsp;/&nbsp;freq_andalus</span><span class="mtk1">i))</span></span><br><span><span></span></span><br><span><span class="mtk15">print</span><span class="mtk1">(</span><span class="mtk21">"===&nbsp;VALIDACIÓN&nbsp;MATEMÁTICA&nbsp;DEL&nbsp;MODELO&nbsp;FONÉTICO&nbsp;</span><span class="mtk21">==="</span><span class="mtk1">)</span></span><br><span><span class="mtk15">print</span><span class="mtk1">(</span><span class="mtk6">f</span><span class="mtk21">"Coeficiente&nbsp;de&nbsp;correlación&nbsp;de&nbsp;Pearson&nbsp;(r):&nbsp;</span><span class="mtk1">{corr</span><span class="mtk12">:.4f</span><span class="mtk1">}</span><span class="mtk21">"</span><span class="m